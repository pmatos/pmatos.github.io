{#- Grand staff. Middle C is written first in the treble staff (Notes), then in the bass staff (Code). -#}
{% macro grandStaff() %}
<figure class="gs-fig">
<div class="gs" role="img" aria-label="An engraved grand staff. Middle C sounds first in the treble staff, labelled Notes, and then in the bass staff, labelled Code.">
  <div class="gs-names" aria-hidden="true"><span class="gs-name gs-name--up">Notes</span><span class="gs-name gs-name--low">Code</span></div>
  <div class="gs-system" aria-hidden="true">
    <span class="gs-lines gs-lines--up"></span><span class="gs-lines gs-lines--low"></span>
    <svg class="gs-head" viewBox="-2.3 -2 9.1 16" focusable="false">
      <rect x="-0.08" y="0" width="0.16" height="13"/>
      {{ brace(-0.42, 6.5) }}
      {{ gClef(0.8, 3) }}
      {{ fClef(0.8, 10) }}
      {{ commonTime(5, 2) }}
      {{ commonTime(5, 11) }}
    </svg>
    <div class="gs-m">
      <svg class="gs-note" viewBox="-0.6 -2 3.2 16" focusable="false"><rect class="ledger" x="-0.5" y="4.92" width="2.96" height="0.16"/>{{ wholeNote(5) }}</svg>
      <svg class="gs-rest gs-rest--low" viewBox="-0.1 -2 1.7 16" focusable="false">{{ measureRest(10) }}</svg>
      <span class="gs-bar"></span>
    </div>
    <div class="gs-m">
      <svg class="gs-rest gs-rest--up" viewBox="-0.1 -2 1.7 16" focusable="false">{{ measureRest(1) }}</svg>
      <svg class="gs-note" viewBox="-0.6 -2 3.2 16" focusable="false"><rect class="ledger" x="-0.5" y="7.92" width="2.96" height="0.16"/>{{ wholeNote(8) }}</svg>
      <span class="gs-final"></span>
    </div>
  </div>
</div>
<figcaption class="gs-cap"><em>The same middle C, written in two clefs: one instruction, two machines.</em></figcaption>
</figure>
{% endmacro %}

{#- Opening of a single staff: clef (G for Notes, F for Code) and common time, with no system line
     (a single staff does not open with a barline); the lines run on to a thin barline at the column edge. -#}
{% macro staffOpen(clef="F") %}
<div class="st-open st-open--{{ 'f' if clef == 'F' else 'g' }}" aria-hidden="true">
  <span class="st-lines"></span>
  <svg class="st-head" viewBox="0 -2 7 8" focusable="false">
    {% if clef == "F" %}{{ fClef(0.9, 1) }}{% else %}{{ gClef(0.9, 3) }}{% endif %}
    {{ commonTime(4.6, 2) }}
  </svg>
</div>
{% endmacro %}

{#- Opening system of the catalogue: both voices, braced. Notes (G) over Code (F), clefs and common time only.
     Treble lines at 0-4, bass lines at 7-11 staff spaces. -#}
{% macro staffGrand() %}
<div class="sg" aria-hidden="true">
  <div class="sg-names"><span class="sg-name sg-name--up">Notes</span><span class="sg-name sg-name--low">Code</span></div>
  <div class="sg-system">
    <span class="st-lines sg-lines--up"></span><span class="st-lines sg-lines--low"></span>
    <svg class="sg-head" viewBox="-2.2 -2 8.8 15" focusable="false">
      <rect x="-0.08" y="0" width="0.16" height="11"/>
      <path transform="translate(-0.4 5.5) scale(.0074 -.0035)" d="M-84 -360c0 252 -129 357 -129 360c0 21 129 93 129 360c0 246 -105 537 -105 807c0 339 183 474 189 474c9 0 15 -6 15 -15c0 -24 -132 -93 -132 -366c0 -243 99 -525 99 -792c0 -168 -39 -330 -171 -468c132 -138 171 -300 171 -468c0 -267 -99 -549 -99 -792 c0 -273 132 -342 132 -366c0 -9 -6 -15 -15 -15c-6 0 -189 135 -189 474c0 270 105 561 105 807z"/>
      {{ gClef(0.75, 3) }}
      {{ fClef(0.75, 8) }}
      {{ commonTime(4.45, 2) }}
      {{ commonTime(4.45, 9) }}
    </svg>
    <span class="sg-bar"></span>
  </div>
</div>
{% endmacro %}

{#- Closing staff with a final barline; optional marking (e.g. Fine) above its end. -#}
{% macro staffEnd(mark="") %}
<div class="st-end" aria-hidden="true">
  {% if mark %}<span class="st-mark">{{ mark }}</span>{% endif %}
  <span class="st-lines"></span><span class="st-final"></span>
</div>
{% endmacro %}

