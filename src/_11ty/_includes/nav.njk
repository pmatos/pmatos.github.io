<a class="skip-link" href="#main">Skip to content</a>
<div class="zones" aria-hidden="true">
    <div class="zones-x zones-x--top">{% for n in range(1, 9) %}<span>{{ n }}</span>{% endfor %}</div>
    <div class="zones-x zones-x--bottom">{% for n in range(1, 9) %}<span>{{ n }}</span>{% endfor %}</div>
    <div class="zones-y zones-y--left">{% for l in ["A", "B", "C", "D", "E", "F"] %}<span>{{ l }}</span>{% endfor %}</div>
    <div class="zones-y zones-y--right">{% for l in ["A", "B", "C", "D", "E", "F"] %}<span>{{ l }}</span>{% endfor %}</div>
</div>
<header class="rh" id="top">
    <a class="rh-title" href="{{ '/' | url }}">{{ meta.siteName }}</a>
    <nav class="rh-nav" aria-label="Main">
        {% set navPages = collections.all | eleventyNavigation %}
        <ul>
            {%- for entry in navPages %}
            {%- set isHere = entry.url == page.url %}
            {%- set inSection = entry.title == "Blog" and page.url and page.url.startsWith("/blog/") %}
            <li{% if isHere or inSection %} class="is-active"{% endif %}><a href="{{ entry.url | url }}"{% if isHere %} aria-current="page"{% elif inSection %} aria-current="true"{% endif %}>{{ entry.title }}</a></li>
            {%- endfor %}
        </ul>
    </nav>
    <div class="rh-theme" id="theme-slot"></div>
</header>
